# Polymarket proxy wallet credentials.
# Get these from your Polymarket account settings or from the wallet you
# registered with Polymarket. NEVER commit the real .env file.

# Hex private key (0x...) of the EOA that controls the Polymarket proxy wallet.
PK_PRIVATE_KEY=

# Proxy wallet address (the address that actually holds funds on Polymarket).
PK_FUNDER=

# Signature type. 1 = email/Magic wallet, 2 = browser wallet.
PK_SIGNATURE_TYPE=1

# Optional: override CLOB host (default https://clob.polymarket.com).
# CLOB_HOST=https://clob.polymarket.com

# Optional path to YAML config; default ./config.yaml
# POLYBOT_CONFIG=config.yaml

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
